% ==========================================
% 1. PARAMETERS & INPUTS
% ==========================================
startup_time = 15.0;      % min (Taxi & Takeoff)
cruise_alt   = 25000.0;   % ft
res_alt      = 10000.0;   % ft (for go around)
total_range_ft = 400.0 * 6076.12; % ft

% Airspeeds
v_climb_kts  = 155.0;
v_cruise_kts = 250.0;
v_desc_kts   = 200.0;
v_loiter_kts = 135.0; 

v_climb_ftmin  = v_climb_kts * 101.269;
v_cruise_ftmin = v_cruise_kts * 101.269;
v_desc_ftmin   = v_desc_kts * 101.269;

% Angles
climb_angle_rad = 5.0 * (pi / 180.0); % 5 deg climb
desc_angle_rad  = 3.0 * (pi / 180.0); % 3 deg descent standard

% ==========================================
% 2. MAIN MISSION PROFILE CALCULATIONS
% ==========================================
% Climb Segment
climb_rate = v_climb_ftmin * sin(climb_angle_rad);  % ft/min
climb_time = cruise_alt / climb_rate;               % min
climb_dist_ft = climb_time * v_climb_ftmin * cos(climb_angle_rad);

% Descent Segment
desc_rate = v_desc_ftmin * sin(desc_angle_rad);     % ft/min
desc_time = cruise_alt / desc_rate;                % min
desc_dist_ft = desc_time * v_desc_ftmin * cos(desc_angle_rad);

% Cruise Segment (Main Mission Range Balance)
cruise_dist_ft = total_range_ft - climb_dist_ft - desc_dist_ft;
cruise_time = cruise_dist_ft / v_cruise_ftmin;     % min

main_loiter_time = 15.0; % min (Approach / Pattern)

% ==========================================
% 3. REALISTIC IFR RESERVE PROFILE
% ==========================================
% Phase A: Missed Approach Climb to 10,000 ft
res_climb_time = res_alt / climb_rate;
res_climb_dist_ft = res_climb_time * v_climb_ftmin * cos(climb_angle_rad);

% Phase B: Alternate Diversion Cruise (Fixed 50 nmi)
alt_dist_nmi = 50.0;
alt_dist_ft  = alt_dist_nmi * 6076.12;
res_alt_cruise_time = alt_dist_ft / v_cruise_ftmin; % min

% Phase C: Reserve Descent to Alternate Airport
res_desc_time = res_alt / desc_rate;
res_desc_dist_ft = res_desc_time * v_desc_ftmin * cos(desc_angle_rad);

% Phase D: Remaining Holding Reserve at L/D_max (0 nmi net distance)
res_loiter_time = max(0.0, 45.0 - res_climb_time - res_alt_cruise_time - res_desc_time);

% Unit Conversions to Nautical Miles
r_climb     = climb_dist_ft / 6076.12;
r_cruise    = cruise_dist_ft / 6076.12;
r_desc      = desc_dist_ft / 6076.12;
r_res_climb = res_climb_dist_ft / 6076.12;
r_res_alt   = alt_dist_nmi;
r_res_desc  = res_desc_dist_ft / 6076.12;
r_res_hold  = 0.0; % Holding pattern produces 0 nmi displacement

% ==========================================
% 4. PLOTTING TIME & ALTITUDE VECTOR
% ==========================================
durations = [0, startup_time, climb_time, cruise_time, desc_time, ...
             main_loiter_time, res_climb_time, res_alt_cruise_time, ...
             res_loiter_time, res_desc_time];

milestones = cumsum(durations);
altitudes  = [0, 0, cruise_alt, cruise_alt, 0, 0, res_alt, res_alt, res_alt, 0];

t_total = milestones(end);
t_vec = linspace(0, t_total, 1000);
alt_vec = interp1(milestones, altitudes, t_vec, 'linear');

% Plot Generation
figure('Color', 'w', 'Position', [100, 100, 1000, 500]);
plot(t_vec, alt_vec, 'b-', 'LineWidth', 2.5, 'DisplayName', 'Flight Profile');
hold on;

% Vertical segment boundary lines
for i = 2:length(milestones)-1
    xline(milestones(i), ':', 'Color', [0.5 0.5 0.5 0.5], 'HandleVisibility', 'off');
end

% Annotation labels: {Name, Y-position, Distance string}
labels = {'Startup', 'Climb', 'Cruise', 'Descent', 'Loiter', ...
          sprintf('Reserve\nClimb'), sprintf('Diversion\nCruise'), ...
          sprintf('Reserve\nHolding'), sprintf('Reserve\nDescent')};

y_positions = [1200, 14000, 26000, 14000, 1200, 5000, 11200, 11200, 5000];
dist_strings = {'0 nmi', sprintf('%.1f nmi', r_climb), sprintf('%.1f nmi', r_cruise), ...
                sprintf('%.1f nmi', r_desc), '0 nmi', sprintf('%.1f nmi', r_res_climb), ...
                sprintf('%.1f nmi', r_res_alt), '0 nmi', sprintf('%.1f nmi', r_res_desc)};

for i = 1:length(labels)
    t_mid = (milestones(i) + milestones(i+1)) / 2;
    text(t_mid, y_positions(i), sprintf('%s\n(%s)', labels{i}, dist_strings{i}), ...
        'HorizontalAlignment', 'center', 'VerticalAlignment', 'middle', ...
        'FontSize', 8.5, 'FontWeight', 'bold', ...
        'BackgroundColor', 'w', 'EdgeColor', [0 0 0.5], 'Margin', 3);
end

title('FAR 23 Mission Profile with Realistic IFR Alternate & Reserve Breakdown', 'FontSize', 12, 'FontWeight', 'bold');
xlabel('Time (minutes)', 'FontSize', 11);
ylabel('Altitude (feet)', 'FontSize', 11);
ylim([-1000, 29000]);
xlim([0, t_total + 2]);
grid on;
ax = gca;
ax.GridLineStyle = ':';
ax.GridAlpha = 0.6;